static func data(value: String) -> String:
	return TranslationServer.translate(KEYS.get(value, value))

static func effect(id: String, rank: int) -> String:
	var multipliers := {"ambush": 60, "vigor": 20, "mercy": 8, "curse": 25, "rot": 35}
	if id == "funeral": return TranslationServer.translate("EFFECT_FUNERAL") % [40 * rank, 30 * rank]
	return TranslationServer.translate("EFFECT_" + id.to_upper()) % (multipliers.get(id, 0) * rank)
